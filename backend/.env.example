# Get a free key at https://console.groq.com/keys
# Leave empty to run in offline demo mode (scripted AI responses).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# SQLite for local dev; Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./haven.db

# Change this in any shared or deployed environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
