# Copy to .env and fill in. Never commit .env.

# Free key: https://console.groq.com/keys (leave empty for offline demo mode)
GROQ_API_KEY=

# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=troy
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Accounts that become admins on sign-up (comma-separated)
# ADMIN_EMAILS=you@example.com

# Local fallback LLM when Groq is unavailable (set empty to disable)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:latest

# Required in any shared or deployed environment
# JWT_SECRET=use-a-long-random-string
